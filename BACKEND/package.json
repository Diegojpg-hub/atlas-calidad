{
  "name": "atlas",
  "version": "1.0.0",
  "description": "API Atlas - Express + PostgreSQL (intencionalmente vulnerable)",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon",
    "postinstall": "node scripts/patch-express-proxy.js && node scripts/patch-express-routing.js",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@swc/wasm": "1.16.22",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "forwarded": "0.2.0",
    "helmet": "^8.3.0",
    "ipaddr.js": "1.9.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "path-to-regexp": "9.0.0",
    "pg": "^8.23.1",
    "proxy-addr": "npm:ip-address@10.7.6",
    "swagger-ui-express": "^5.0.1",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.0",
    "supertest": "^7.3.1"
  },
  "overrides": {
    "express": {
      "proxy-addr": "$proxy-addr",
      "path-to-regexp": "$path-to-regexp",
      "body-parser": {
        ".": "1.20.9",
        "raw-body": "2.5.2",
        "http-errors": "2.0.0"
      }
    }
  }
}
